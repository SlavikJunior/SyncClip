# ============================================================================
# SyncClip — корневой .gitignore
#
# Репозиторий-контейнер: syncclip-client/ (KMP) и syncclip-backend/ (Ktor).
# Здесь только общие правила; сборка, IDE-артефакты и платформенные файлы
# игнорируются в syncclip-client/.gitignore и syncclip-backend/.gitignore.
# ============================================================================

# OS
.DS_Store
Thumbs.db
.Spotlight-V100
Trash*

# macOS metadata
__MACOSX
.e4xmt

# JetBrains IDEs (корневые проекты открываются отдельно)
.idea/
*.iml
*.ipr
*.iws
*.iws.xml
*.prj
out/

# Environment / secrets
.env
.env.local
.env.*.local
auth.json
secrets.gradle

# Logs
*.log
*.log.*
logs/

# Temporary files
*.tmp
*.temp
*.swp
*~

# Общие артефакты сборки на любой глубине (страховка)
.gradle/
build/
.kotlin/

# ============================================================================
# Локальные служебные материалы (не часть продукта)
# ============================================================================
docs/*
AGENTS.md
/swarm-report/
.harness/
opencode.jsonc

# ============================================================================
# End of .gitignore
# ============================================================================
