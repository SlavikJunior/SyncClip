# Секреты только через env / docker secret. Значения НЕ коммитятся.

# Обязательные
DB_PASSWORD=
JWT_SECRET=

# PROD-профиль (docker compose): обязателен, иначе сервер не стартует.
APP_ENV=prod
# Адреса/CIDR reverse proxy через запятую, например: 172.18.0.2/32,10.0.0.0/8
TRUSTED_PROXIES=

# Push (noop | fcm). Для fcm положите service-account JSON в ./secrets/fcm.json.
PUSH_PROVIDER=noop
FCM_CREDENTIALS_PATH=/run/secrets/fcm.json

# Auth provider: password (default) | firebase (additive, SEC-10).
AUTH_PROVIDER=password
FIREBASE_PROJECT_ID=
FIREBASE_JWKS_URL=https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com
FIREBASE_REQUIRE_VERIFIED_EMAIL=true

# Опциональные лимиты (значения по умолчанию)
# PASSWORD_HASH_ITERATIONS=600000
# DB_STATEMENT_TIMEOUT_MS=10000
# LOGIN_LOCKOUT_ENABLED=false
# WS_MAX_CONNECTIONS_PER_USER=8
# WS_MAX_CONNECTIONS_PER_DEVICE=3
# WS_MAX_INITIAL_PENDING_BYTES=4194304

# Prometheus-метрики (OPS-07): при включении обязателен токен >= 16 символов.
# METRICS_ENABLED=false
# METRICS_TOKEN=
