{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "servers": {
            "figma": {
                "type": "remote",
                "url": "https://mcp.figma.com/mcp"
            },
            "compose-hot-reload": {
                "type": "local",
                "command": [
                    "./syncclip-client/gradlew",
                    "-p",
                    "syncclip-client",
                    "--no-daemon",
                    "--quiet",
                    "--console=plain",
                    "hotMcpServer"
                ]
            },
            "firebase": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "firebase-tools@latest",
                    "mcp"
                ]
            }
        }
    }
}
